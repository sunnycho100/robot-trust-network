              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3
            },
            "minItems": 3
          },
          "t": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3
          },
          "source": {
            "type": "string"
          },
          "reproj_rmse_px": {
            "type": [
              "number",
