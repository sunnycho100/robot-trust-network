# Copy to .env and fill in. Any OpenAI-compatible endpoint works, the model must accept images and tool calls.

# Gemini (OpenAI-compatible endpoint)
VLA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
VLA_API_KEY=your-gemini-key
VLA_MODEL=put-the-exact-gemini-flash-model-id-here

# OpenAI (uncomment to switch)
# VLA_BASE_URL=https://api.openai.com/v1
# VLA_API_KEY=your-openai-key
# VLA_MODEL=put-the-exact-gpt-model-id-here

# Local model through Ollama or LM Studio (free, no key)
# VLA_BASE_URL=http://localhost:11434/v1
# VLA_API_KEY=ollama
# VLA_MODEL=qwen2.5vl

# How hard the model thinks per move: low is about 10s, high about 60s. Delete for models that do not support it.
VLA_REASONING_EFFORT=low
